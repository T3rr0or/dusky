{
  "$schema": "vscode://schemas/color-theme",
  "name": "DankShell Light - Generated",
  "type": "light",
  "colors": {
    "editor.background": "#fcf8ff",
    "editor.foreground": "#1b1b21",
    "editor.lineNumberColor": "#47464f",
    "editorLineNumber.foreground": "#47464f",
    "editorLineNumber.activeForeground": "#1b1b21",
    "editorCursor.foreground": "#575992",
    "editor.selectionBackground": "#e1e0ff60",
    "editor.wordHighlightBackground": "#e2e0f940",
    "editor.lineHighlightBackground": "#f0ecf440",
    "editorWhitespace.foreground": "#c8c5d0",
    "editorIndentGuide.foreground": "#c8c5d040",
    "editorError.foreground": "#ba1a1a",
    "editorWarning.foreground": "#ffd8ec",
    "editorInfo.foreground": "#5d5c72",
    "editorHint.foreground": "#795369",
    "activityBar.background": "#f6f2fa",
    "activityBar.foreground": "#47464f",
    "activityBar.activeBorder": "#575992",
    "activityBarBadge.background": "#575992",
    "activityBarBadge.foreground": "#ffffff",
    "sideBar.background": "#f6f2fa",
    "sideBar.foreground": "#47464f",
    "sideBar.border": "#c8c5d020",
    "sideBarTitle.foreground": "#1b1b21",
    "sideBarSectionHeader.background": "#f0ecf4",
    "sideBarSectionHeader.foreground": "#1b1b21",
    "list.focusBackground": "#f0ecf4",
    "list.hoverBackground": "#f0ecf440",
    "list.activeSelectionBackground": "#e1e0ff",
    "list.activeSelectionForeground": "#13144a",
    "list.inactiveSelectionBackground": "#eae7ef",
    "statusBar.background": "#e4e1e9",
    "statusBar.foreground": "#1b1b21",
    "statusBar.border": "#c8c5d020",
    "statusBar.debuggingBackground": "#ffdad6",
    "statusBar.debuggingForeground": "#410002",
    "statusBarItem.hoverBackground": "#e4e1e980",
    "titleBar.activeBackground": "#ffffff",
    "titleBar.activeForeground": "#1b1b21",
    "titleBar.inactiveBackground": "#ffffff80",
    "titleBar.inactiveForeground": "#47464f",
    "commandCenter.background": "#f0ecf4",
    "commandCenter.foreground": "#1b1b21",
    "commandCenter.border": "#c8c5d040",
    "tab.activeBackground": "#f0ecf4",
    "tab.activeForeground": "#1b1b21",
    "tab.activeBorder": "#575992",
    "tab.inactiveBackground": "#f6f2fa",
    "tab.inactiveForeground": "#47464f",
    "tab.hoverBackground": "#f0ecf440",
    "tab.border": "#c8c5d020",
    "tab.unfocusedActiveBackground": "#f0ecf460",
    "tab.unfocusedActiveForeground": "#47464f",
    "input.background": "#eae7ef",
    "input.foreground": "#1b1b21",
    "input.border": "#c8c5d040",
    "input.placeholderForeground": "#47464f",
    "inputOption.activeBackground": "#e1e0ff",
    "inputOption.activeForeground": "#13144a",
    "button.background": "#575992",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#575992dd",
    "button.secondaryBackground": "#5d5c72",
    "button.secondaryForeground": "#ffffff",
    "button.secondaryHoverBackground": "#5d5c72dd",
    "dropdown.background": "#eae7ef",
    "dropdown.foreground": "#1b1b21",
    "dropdown.border": "#c8c5d040",
    "progressBar.background": "#575992",
    "scrollbar.shadow": "#00000040",
    "scrollbarSlider.background": "#c8c5d040",
    "scrollbarSlider.hoverBackground": "#c8c5d060",
    "scrollbarSlider.activeBackground": "#c8c5d080",
    "editorGroup.border": "#c8c5d020",
    "editorGroup.dropBackground": "#e1e0ff40",
    "editorGroupHeader.tabsBackground": "#f6f2fa",
    "editorGroupHeader.tabsBorder": "#c8c5d020",
    "diffEditor.insertedTextBackground": "#ffd8ec40",
    "diffEditor.removedTextBackground": "#ffdad640",
    "diffEditor.diagonalFill": "#c8c5d020",
    "minimap.background": "#f6f2fa",
    "minimap.selectionHighlight": "#e1e0ff60",
    "minimap.errorHighlight": "#ba1a1a60",
    "minimap.warningHighlight": "#ffd8ec60",
    "peekView.border": "#c8c5d0",
    "peekViewEditor.background": "#f0ecf480",
    "peekViewEditor.matchHighlightBackground": "#e2e0f960",
    "peekViewResult.background": "#f6f2fa",
    "peekViewResult.matchHighlightBackground": "#e2e0f940",
    "peekViewResult.selectionBackground": "#e1e0ff40",
    "widget.shadow": "#00000040",
    "problemsErrorIcon.foreground": "#ba1a1a",
    "problemsWarningIcon.foreground": "#ffd8ec",
    "problemsInfoIcon.foreground": "#5d5c72",
    "debugExceptionWidget.background": "#ffdad6",
    "debugExceptionWidget.border": "#ba1a1a",
    "debugToolBar.background": "#f0ecf4",
    "debugToolBar.border": "#c8c5d020",
    "breadcrumb.background": "#fcf8ff",
    "breadcrumb.foreground": "#47464f",
    "breadcrumb.focusForeground": "#1b1b21",
    "breadcrumb.activeSelectionForeground": "#575992"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment"],
      "settings": {
        "foreground": "#47464f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": ["string"],
      "settings": {
        "foreground": "#795369"
      }
    },
    {
      "name": "String Escape",
      "scope": ["constant.character.escape"],
      "settings": {
        "foreground": "#5d5c72"
      }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#5d5c72"
      }
    },
    {
      "name": "Boolean",
      "scope": ["constant.language.boolean"],
      "settings": {
        "foreground": "#5d5c72"
      }
    },
    {
      "name": "Built-in Constant",
      "scope": ["constant.language"],
      "settings": {
        "foreground": "#5d5c72"
      }
    },
    {
      "name": "Variable",
      "scope": ["variable"],
      "settings": {
        "foreground": "#1b1b21"
      }
    },
    {
      "name": "Keyword",
      "scope": ["keyword"],
      "settings": {
        "foreground": "#575992"
      }
    },
    {
      "name": "Storage",
      "scope": ["storage"],
      "settings": {
        "foreground": "#575992"
      }
    },
    {
      "name": "Storage Type",
      "scope": ["storage.type"],
      "settings": {
        "foreground": "#575992"
      }
    },
    {
      "name": "Class name",
      "scope": ["entity.name.class"],
      "settings": {
        "fontStyle": "",
        "foreground": "#5d5c72"
      }
    },
    {
      "name": "Inherited class",
      "scope": ["entity.other.inherited-class"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#5d5c72"
      }
    },
    {
      "name": "Function name",
      "scope": ["entity.name.function"],
      "settings": {
        "fontStyle": "",
        "foreground": "#5d5c72"
      }
    },
    {
      "name": "Function argument",
      "scope": ["variable.parameter"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#47464f"
      }
    },
    {
      "name": "Tag name",
      "scope": ["entity.name.tag"],
      "settings": {
        "fontStyle": "",
        "foreground": "#575992"
      }
    },
    {
      "name": "Tag attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "fontStyle": "",
        "foreground": "#5d5c72"
      }
    },
    {
      "name": "Library function",
      "scope": ["support.function"],
      "settings": {
        "fontStyle": "",
        "foreground": "#5d5c72"
      }
    },
    {
      "name": "Library constant",
      "scope": ["support.constant"],
      "settings": {
        "fontStyle": "",
        "foreground": "#5d5c72"
      }
    },
    {
      "name": "Library class/type",
      "scope": ["support.type", "support.class"],
      "settings": {
        "fontStyle": "",
        "foreground": "#5d5c72"
      }
    },
    {
      "name": "Library variable",
      "scope": ["support.other.variable"],
      "settings": {
        "fontStyle": ""
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid"],
      "settings": {
        "background": "#ba1a1a",
        "fontStyle": "",
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Invalid deprecated",
      "scope": ["invalid.deprecated"],
      "settings": {
        "background": "#ffdad6",
        "foreground": "#410002"
      }
    },
    {
      "name": "Markup: Emphasis",
      "scope": ["markup.italic"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#5d5c72"
      }
    },
    {
      "name": "Markup: Strong",
      "scope": ["markup.bold"],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#5d5c72"
      }
    },
    {
      "name": "Markup: Underline",
      "scope": ["markup.underline"],
      "settings": {
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup: Heading",
      "scope": ["markup.heading"],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#575992"
      }
    },
    {
      "name": "Markup: Link",
      "scope": ["markup.underline.link"],
      "settings": {
        "foreground": "#5d5c72"
      }
    }
  ]
}
