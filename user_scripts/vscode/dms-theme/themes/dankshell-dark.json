{
  "$schema": "vscode://schemas/color-theme",
  "name": "DankShell Dark - Generated",
  "type": "dark",
  "colors": {
    "editor.background": "#131318",
    "editor.foreground": "#e4e1e9",
    "editor.lineNumberColor": "#c8c5d0",
    "editorLineNumber.foreground": "#c8c5d0",
    "editorLineNumber.activeForeground": "#e4e1e9",
    "editorCursor.foreground": "#c0c1ff",
    "editor.selectionBackground": "#40417860",
    "editor.wordHighlightBackground": "#45455940",
    "editor.lineHighlightBackground": "#1f1f2540",
    "editorWhitespace.foreground": "#47464f",
    "editorIndentGuide.foreground": "#47464f40",
    "editorError.foreground": "#ffb4ab",
    "editorWarning.foreground": "#ffd8ec",
    "editorInfo.foreground": "#c6c4dd",
    "editorHint.foreground": "#e9b9d3",
    "activityBar.background": "#1b1b21",
    "activityBar.foreground": "#c8c5d0",
    "activityBar.activeBorder": "#c0c1ff",
    "activityBarBadge.background": "#c0c1ff",
    "activityBarBadge.foreground": "#292a60",
    "sideBar.background": "#1b1b21",
    "sideBar.foreground": "#c8c5d0",
    "sideBar.border": "#47464f20",
    "sideBarTitle.foreground": "#e4e1e9",
    "sideBarSectionHeader.background": "#1f1f25",
    "sideBarSectionHeader.foreground": "#e4e1e9",
    "list.focusBackground": "#1f1f25",
    "list.hoverBackground": "#1f1f2540",
    "list.activeSelectionBackground": "#404178",
    "list.activeSelectionForeground": "#e1e0ff",
    "list.inactiveSelectionBackground": "#2a292f",
    "statusBar.background": "#35343a",
    "statusBar.foreground": "#e4e1e9",
    "statusBar.border": "#47464f20",
    "statusBar.debuggingBackground": "#93000a",
    "statusBar.debuggingForeground": "#ffdad6",
    "statusBarItem.hoverBackground": "#35343a80",
    "titleBar.activeBackground": "#0e0e13",
    "titleBar.activeForeground": "#e4e1e9",
    "titleBar.inactiveBackground": "#0e0e1380",
    "titleBar.inactiveForeground": "#c8c5d0",
    "commandCenter.background": "#1f1f25",
    "commandCenter.foreground": "#e4e1e9",
    "commandCenter.border": "#47464f40",
    "tab.activeBackground": "#1f1f25",
    "tab.activeForeground": "#e4e1e9",
    "tab.activeBorder": "#c0c1ff",
    "tab.inactiveBackground": "#1b1b21",
    "tab.inactiveForeground": "#c8c5d0",
    "tab.hoverBackground": "#1f1f2540",
    "tab.border": "#47464f20",
    "tab.unfocusedActiveBackground": "#1f1f2560",
    "tab.unfocusedActiveForeground": "#c8c5d0",
    "input.background": "#2a292f",
    "input.foreground": "#e4e1e9",
    "input.border": "#47464f40",
    "input.placeholderForeground": "#c8c5d0",
    "inputOption.activeBackground": "#404178",
    "inputOption.activeForeground": "#e1e0ff",
    "button.background": "#c0c1ff",
    "button.foreground": "#292a60",
    "button.hoverBackground": "#c0c1ffdd",
    "button.secondaryBackground": "#c6c4dd",
    "button.secondaryForeground": "#2e2f42",
    "button.secondaryHoverBackground": "#c6c4dddd",
    "dropdown.background": "#2a292f",
    "dropdown.foreground": "#e4e1e9",
    "dropdown.border": "#47464f40",
    "progressBar.background": "#c0c1ff",
    "scrollbar.shadow": "#00000040",
    "scrollbarSlider.background": "#47464f40",
    "scrollbarSlider.hoverBackground": "#47464f60",
    "scrollbarSlider.activeBackground": "#47464f80",
    "editorGroup.border": "#47464f20",
    "editorGroup.dropBackground": "#40417840",
    "editorGroupHeader.tabsBackground": "#1b1b21",
    "editorGroupHeader.tabsBorder": "#47464f20",
    "diffEditor.insertedTextBackground": "#5f3c5140",
    "diffEditor.removedTextBackground": "#93000a40",
    "diffEditor.diagonalFill": "#47464f20",
    "minimap.background": "#1b1b21",
    "minimap.selectionHighlight": "#40417860",
    "minimap.errorHighlight": "#ffb4ab60",
    "minimap.warningHighlight": "#ffd8ec60",
    "peekView.border": "#47464f",
    "peekViewEditor.background": "#1f1f2580",
    "peekViewEditor.matchHighlightBackground": "#45455960",
    "peekViewResult.background": "#1b1b21",
    "peekViewResult.matchHighlightBackground": "#45455940",
    "peekViewResult.selectionBackground": "#40417840",
    "widget.shadow": "#00000040",
    "problemsErrorIcon.foreground": "#ffb4ab",
    "problemsWarningIcon.foreground": "#ffd8ec",
    "problemsInfoIcon.foreground": "#c6c4dd",
    "debugExceptionWidget.background": "#93000a",
    "debugExceptionWidget.border": "#ffb4ab",
    "debugToolBar.background": "#1f1f25",
    "debugToolBar.border": "#47464f20",
    "breadcrumb.background": "#131318",
    "breadcrumb.foreground": "#c8c5d0",
    "breadcrumb.focusForeground": "#e4e1e9",
    "breadcrumb.activeSelectionForeground": "#c0c1ff"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment"],
      "settings": {
        "foreground": "#c8c5d0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": ["string"],
      "settings": {
        "foreground": "#e9b9d3"
      }
    },
    {
      "name": "String Escape",
      "scope": ["constant.character.escape"],
      "settings": {
        "foreground": "#c6c4dd"
      }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#c6c4dd"
      }
    },
    {
      "name": "Boolean",
      "scope": ["constant.language.boolean"],
      "settings": {
        "foreground": "#c6c4dd"
      }
    },
    {
      "name": "Built-in Constant",
      "scope": ["constant.language"],
      "settings": {
        "foreground": "#c6c4dd"
      }
    },
    {
      "name": "Variable",
      "scope": ["variable"],
      "settings": {
        "foreground": "#e4e1e9"
      }
    },
    {
      "name": "Keyword",
      "scope": ["keyword"],
      "settings": {
        "foreground": "#c0c1ff"
      }
    },
    {
      "name": "Storage",
      "scope": ["storage"],
      "settings": {
        "foreground": "#c0c1ff"
      }
    },
    {
      "name": "Storage Type",
      "scope": ["storage.type"],
      "settings": {
        "foreground": "#c0c1ff"
      }
    },
    {
      "name": "Class name",
      "scope": ["entity.name.class"],
      "settings": {
        "fontStyle": "",
        "foreground": "#c6c4dd"
      }
    },
    {
      "name": "Inherited class",
      "scope": ["entity.other.inherited-class"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#c6c4dd"
      }
    },
    {
      "name": "Function name",
      "scope": ["entity.name.function"],
      "settings": {
        "fontStyle": "",
        "foreground": "#c6c4dd"
      }
    },
    {
      "name": "Function argument",
      "scope": ["variable.parameter"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#c8c5d0"
      }
    },
    {
      "name": "Tag name",
      "scope": ["entity.name.tag"],
      "settings": {
        "fontStyle": "",
        "foreground": "#c0c1ff"
      }
    },
    {
      "name": "Tag attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "fontStyle": "",
        "foreground": "#c6c4dd"
      }
    },
    {
      "name": "Library function",
      "scope": ["support.function"],
      "settings": {
        "fontStyle": "",
        "foreground": "#c6c4dd"
      }
    },
    {
      "name": "Library constant",
      "scope": ["support.constant"],
      "settings": {
        "fontStyle": "",
        "foreground": "#c6c4dd"
      }
    },
    {
      "name": "Library class/type",
      "scope": ["support.type", "support.class"],
      "settings": {
        "fontStyle": "",
        "foreground": "#c6c4dd"
      }
    },
    {
      "name": "Library variable",
      "scope": ["support.other.variable"],
      "settings": {
        "fontStyle": ""
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid"],
      "settings": {
        "background": "#ffb4ab",
        "fontStyle": "",
        "foreground": "#690005"
      }
    },
    {
      "name": "Invalid deprecated",
      "scope": ["invalid.deprecated"],
      "settings": {
        "background": "#93000a",
        "foreground": "#ffdad6"
      }
    },
    {
      "name": "Markup: Emphasis",
      "scope": ["markup.italic"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#c6c4dd"
      }
    },
    {
      "name": "Markup: Strong",
      "scope": ["markup.bold"],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#c6c4dd"
      }
    },
    {
      "name": "Markup: Underline",
      "scope": ["markup.underline"],
      "settings": {
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup: Heading",
      "scope": ["markup.heading"],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#c0c1ff"
      }
    },
    {
      "name": "Markup: Link",
      "scope": ["markup.underline.link"],
      "settings": {
        "foreground": "#c6c4dd"
      }
    }
  ]
}
